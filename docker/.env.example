# Copy to `.env` and fill in your foundryvtt.com credentials.
# These are used ONCE, at container start-up, to download and license the
# proprietary FoundryVTT application. They are never stored in the image.

FOUNDRY_USERNAME=you@example.com
FOUNDRY_PASSWORD=your-password

# Optional: pin a specific license key (otherwise one associated with your
# account is selected automatically). Format: XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
FOUNDRY_LICENSE_KEY=

# Optional: password for the Foundry setup/admin screen. Leave blank for none.
FOUNDRY_ADMIN_KEY=
