<div class="wy-view-nav">
  <div class="wy-section-title">NAVIGATION — STELLAR CARTOGRAPHY</div>

  <div class="wy-border-box">
    <table class="wy-data-table wy-nav-status-table">
      <tr>
        <td class="wy-text-dim">HEADING:</td>
        <td id="wy-nav-heading">{{heading}}°</td>
        <td class="wy-text-dim">SPEED:</td>
        <td id="wy-nav-speed">{{speed}}</td>
      </tr>
      <tr>
        <td class="wy-text-dim">FUEL RESERVES:</td>
        <td class="{{fuelClass}}" id="wy-nav-fuel">{{fuelLevel}}</td>
        <td class="wy-text-dim">ETA:</td>
        <td class="wy-text-amber" id="wy-nav-eta-display">{{eta}}{{#if etaCountdownMs}} <span style="font-size: 10px; color: {{#if clockPaused}}var(--wy-amber){{else}}var(--wy-green-dim){{/if}};">{{#if clockPaused}}[PAUSED]{{else}}[LIVE]{{/if}}</span>{{/if}}</td>
      </tr>
      <tr>
        <td class="wy-text-dim">ENGINES:</td>
        <td class="{{engineClass}}">{{engineStatus}}</td>
        <td class="wy-text-dim">THRUSTERS:</td>
        <td class="{{thrusterClass}}">{{thrusterStatus}}</td>
      </tr>
      <tr>
        <td class="wy-text-dim">POSITION:</td>
        <td id="wy-nav-position">{{currentPosition}}</td>
        <td class="wy-text-dim">DESTINATION:</td>
        <td id="wy-nav-destination">{{destination}}</td>
      </tr>
      <tr>
        <td class="wy-text-dim">DST COORDINATES:</td>
        <td class="wy-text-amber" id="wy-nav-dstcoords">{{dstCoordinates}}</td>
        <td></td>
        <td></td>
      </tr>
    </table>
    {{#if showThrottle}}
    <div class="wy-nav-throttle" id="wy-nav-throttle">
      <span class="wy-text-dim">ENGINE:</span>
      <button class="wy-nav-throttle-btn" data-action="nav-full-stop" title="All stop">[ FULL STOP ]</button>
      <button class="wy-nav-throttle-btn" data-action="nav-speed-down" title="Reduce speed 0.1 AU/day">[ − 0.1 ]</button>
      <button class="wy-nav-throttle-btn" data-action="nav-speed-up" title="Increase speed 0.1 AU/day">[ + 0.1 ]</button>
      <button class="wy-nav-throttle-btn" data-action="nav-full-speed" title="Maximum speed">[ FULL SPEED ]</button>
    </div>
    {{/if}}
  </div>

  <div class="wy-nav-map-layout">
    <div class="wy-nav-map" id="wy-nav-map">
      {{#if navSceneMissing}}
      <div class="wy-nav-map-empty">
        {{#if isGM}}
        NO <span class="wy-text-amber">"NAV"</span> SCENE FOUND.<br>
        CREATE A FOUNDRY SCENE NAMED <span class="wy-text-amber">NAV</span> (OR NAVIGATION), THEN RUN
        <span class="wy-text-green">GM CONTROLS ▸ CONFIGURE NAV SCENE</span> TO APPLY THE STAR-CHART GRID.<br>
        DROP <span class="wy-text-green">STATION</span> / <span class="wy-text-green">SYSTEM</span> / <span class="wy-text-green">SHIP</span> TOKENS ONTO IT — SOL SITS AT 0,0 (CENTRE).
        {{else}}
        AWAITING STELLAR TELEMETRY FROM NAV COMPUTER…
        {{/if}}
      </div>
      {{else}}
      <div class="wy-nav-map-label">STELLAR NAVIGATION CHART — {{navSceneName}}</div>
      <canvas class="wy-nav-grid" id="wy-nav-grid"></canvas>
      <div class="wy-nav-token-layer" id="wy-nav-token-layer"></div>
      {{/if}}
    </div>
    <div class="wy-nav-readout" id="wy-nav-readout">
      <div class="wy-nav-readout-title">▶ NAV CONTACT</div>
      <div class="wy-nav-readout-body" id="wy-nav-readout-body">
        {{#if navSceneMissing}}
        <div class="wy-text-dim">NO CHART CONFIGURED.</div>
        {{else}}
        <div class="wy-text-dim">NO CONTACT SELECTED.<br>TOUCH A STATION, SYSTEM, OR SHIP ON THE CHART.</div>
        {{/if}}
      </div>
    </div>
  </div>

  {{#if navPoints}}
  <div class="wy-section-title" style="font-size: 13px; margin-top: 12px;">WAYPOINTS</div>
  <div class="wy-border-box">
    <table class="wy-data-table">
      <thead>
        <tr>
          <th>DESIGNATION</th>
          <th>DISTANCE</th>
          <th>TYPE</th>
        </tr>
      </thead>
      <tbody>
        {{#each navPoints}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.distance}}</td>
          <td class="wy-text-dim">{{this.type}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}
</div>
