{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlienPi Launcher",
  "version": "0.1.0",
  "identifier": "com.benthecloudguy.alienpi.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MU/TH/UR",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Game",
    "shortDescription": "MU/TH/UR kiosk launcher for FoundryVTT",
    "longDescription": "Weyland-Yutani themed kiosk launcher that connects WiFi, discovers FoundryVTT games on the LAN, and launches them in a full-screen touch kiosk on Raspberry Pi 5.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "network-manager",
          "avahi-utils",
          "chromium",
          "squeekboard",
          "libwebkit2gtk-4.1-0"
        ]
      }
    }
  }
}
